DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio_db
PORT=3001
SESSION_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars
SESSION_DURATION_HOURS=24
RUST_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# S3 / Cloudflare R2 / AWS S3
STORAGE_BUCKET=portfolio-media
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# For AWS S3: leave empty (uses default endpoint)
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=http://localhost:3001/media

# Admin seed (used by bin/seed-admin if you create it)
ADMIN_USERNAME=admin
ADMIN_EMAIL=toufiqimroz161055@gmail.com
ADMIN_PASSWORD=change-this-strong-password
